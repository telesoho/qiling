{
  "name": "qiling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bake:anim": "node scripts/bake_pet_anim.mjs",
    "predev": "npm run bake:anim",
    "dev": "vite",
    "prebuild": "npm run bake:anim",
    "build": "tsc --noEmit && vite build",
    "sdk:build": "tsc -p sdk/typescript/tsconfig.json",
    "vscode:build": "npm run sdk:build && npm --prefix connectors/vscode run build",
    "vscode:package": "npm run vscode:build && npm --prefix connectors/vscode run package && python scripts/verify_vscode_package.py",
    "vscode:test": "vitest run connectors/vscode/connector-core.test.ts sdk/typescript/src/index.test.ts",
    "preview": "vite preview",
    "pretest": "npm run bake:anim",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@libraz/libsonare": "1.10.0",
    "@tauri-apps/api": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
