{
  "id": "shiju-pickup-hover",
  "displayName": "诗琚·吊起悬停",
  "description": "按下吊起 → 拖动悬空（跟手）→ 松开落下。方案1：scale 锁定 0.408，画布 180×260 保留全序列上升位移；phases.*.asset 支持 animatedWebp / frameSequence。",
  "version": "0.5.0",
  "fps": 24,
  "frameSize": {
    "width": 180,
    "height": 260
  },
  "anchor": {
    "x": 0.5,
    "y": 0.12,
    "note": "无形线抓手约在头顶；拖拽位移相对此锚点"
  },
  "paths": {
    "preview": "preview/all_in_one.webp",
    "struct": "track_struct.json",
    "tracksDir": "tracks"
  },
  "fit": {
    "scale": 0.4081237911025145,
    "scaledSize": 294,
    "viewport": {
      "x": 57,
      "y": 20,
      "w": 180,
      "h": 260
    },
    "frameSize": {
      "width": 180,
      "height": 260
    },
    "unionScaled": {
      "top": 25.711798839458414,
      "bot": 273.0348162475822,
      "h": 247.3230174081238,
      "w": 146.1083172147002
    },
    "margin": 6,
    "method": "fixed_scale_0.408_taller_canvas",
    "note": "scale 锁定 0.408；画布抬高为 180×260 以容纳全序列包围盒（~247.3px + 边距）。帧内上升位移保留，运行时不必再跟框抵消。",
    "standIdleScale": 0.4081237911025145
  },
  "phases": {
    "idle": {
      "label": "待机",
      "playback": "loop",
      "asset": {
        "type": "animatedWebp",
        "src": "../../../public/pet/idle.webp",
        "fps": 24,
        "note": "一体化循环 WebP；src 相对本 JSON 所在目录解析，也可用绝对/其它相对路径"
      },
      "note": "运行时播整段 WebP，不读 tracks/"
    },
    "lift": {
      "label": "吊起",
      "playback": "once",
      "holdAtEnd": true,
      "onHoldComplete": "hover",
      "trigger": "pointerdown",
      "asset": {
        "type": "frameSequence",
        "dir": "tracks",
        "pattern": "frame{NNN}.webp",
        "zeroPad": 3,
        "indexBase": 1,
        "from": 30,
        "to": 72
      }
    },
    "hover": {
      "label": "悬空",
      "playback": "loop",
      "while": "pointerdown",
      "followPointer": true,
      "trigger": "pointermove",
      "enterAlso": "lift.holdAtEnd",
      "asset": {
        "type": "frameSequence",
        "dir": "tracks",
        "pattern": "frame{NNN}.webp",
        "zeroPad": 3,
        "indexBase": 1,
        "from": 73,
        "to": 100
      }
    },
    "drop": {
      "label": "落下",
      "playback": "once",
      "holdAtEnd": true,
      "fallback": "idle",
      "trigger": "pointerup",
      "asset": {
        "type": "frameSequence",
        "dir": "tracks",
        "pattern": "frame{NNN}.webp",
        "zeroPad": 3,
        "indexBase": 1,
        "from": 101,
        "to": 193
      }
    }
  },
  "interrupt": {
    "pointerupDuringLift": "drop",
    "pointerupDuringHover": "drop",
    "pointerdownDuringDrop": "lift",
    "pointerdownWhileIdle": "lift",
    "holdStillAfterLift": "enterHover",
    "rapidClick": "liftThenDrop",
    "notes": [
      "抬起未播完就松手：立刻切 drop（从 drop.from 起播，不回放 lift）",
      "lift 播完且仍按住、即使无 pointermove：自动进 hover 并循环",
      "drop 播到一半再按下：中断 drop，从 lift.from 重播",
      "连点（down→up 几乎无拖）：lift 开播后遇 up 即切 drop；drop 结束后 fallback idle",
      "hover 期间 followPointer=true，角色锚点跟随指针；松手后位置可吸附回默认"
    ]
  },
  "assetTypes": {
    "animatedWebp": {
      "required": ["src"],
      "optional": ["fps", "loopStart", "loopEnd"],
      "desc": "单个有动画的 WebP 文件，整段作为该相位；运行时不拆 tracks/"
    },
    "frameSequence": {
      "required": ["dir", "from", "to"],
      "optional": ["pattern", "zeroPad", "indexBase", "ext"],
      "desc": "目录内连续帧；pattern 默认 frame{NNN}.webp，zeroPad 默认 3，indexBase 默认 1"
    }
  },
  "frameCount": 193,
  "compat": {
    "idleWebpSize": "180x240",
    "note": "本序列画布高于 idle.webp；运行时按 frameSize 布局，idle 相位仍可用 180×240 资源居中叠放"
  },
  "changelog": [
    {
      "version": "0.5.0",
      "note": "方案1：scale 锁定 0.408，frameSize 180×260；fit.method=fixed_scale_0.408_taller_canvas；帧内上升位移保留"
    },
    {
      "version": "0.4.1",
      "note": "方案2：scale 0.408 + 动态 vy；viewport_y 外置；画布内上升由跟框抵消"
    },
    {
      "version": "0.4.0",
      "note": "phases.*.asset 二选一：animatedWebp | frameSequence；idle 可指向 public/pet/*.webp"
    },
    {
      "version": "0.2.0",
      "note": "初版契约：720²、phases.frames.from/to、30 帧示意"
    }
  ]
}
