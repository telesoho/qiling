{
  "id": "shiju-pickup-hover",
  "displayName": "诗琚·吊起悬停",
  "description": "方案1：scale锁定0.408，画布加高以保留全序列上升位移。",
  "version": "0.5.0",
  "fps": 24,
  "frameSize": {
    "width": 180,
    "height": 260
  },
  "anchor": {
    "x": 0.5,
    "y": 0.12,
    "note": "无形线抓手约在头顶；拖拽位移相对此锚点"
  },
  "paths": {
    "preview": "preview/all_in_one.webp",
    "struct": "track_struct.json",
    "tracksDir": "tracks"
  },
  "fit": {
    "scale": 0.4081237911025145,
    "scaledSize": 294,
    "viewport": {
      "x": 57,
      "y": 20,
      "w": 180,
      "h": 260
    },
    "frameSize": {
      "width": 180,
      "height": 260
    },
    "unionScaled": {
      "top": 25.711798839458414,
      "bot": 273.0348162475822,
      "h": 247.3230174081238,
      "w": 146.1083172147002
    },
    "margin": 6,
    "method": "fixed_scale_0.408_taller_canvas",
    "note": "scale锁定0.408；画布抬高为180×260以容纳全序列包围盒(~247.3px+边距)",
    "standIdleScale": 0.4081237911025145
  },
  "phases": {
    "idle": {
      "label": "待机",
      "playback": "loop",
      "asset": {
        "type": "animatedWebp",
        "src": "../../../public/pet/idle.webp",
        "fps": 24,
        "note": "一体化循环 WebP；也可用绝对/其它相对路径"
      },
      "note": "运行时播整段 WebP，不读 tracks/"
    },
    "lift": {
      "label": "吊起",
      "playback": "once",
      "holdAtEnd": true,
      "onHoldComplete": "hover",
      "trigger": "pointerdown",
      "asset": {
        "type": "frameSequence",
        "dir": "tracks",
        "pattern": "frame{NNN}.webp",
        "zeroPad": 3,
        "indexBase": 1,
        "from": 30,
        "to": 72
      }
    },
    "hover": {
      "label": "悬空",
      "playback": "loop",
      "while": "pointerdown",
      "followPointer": true,
      "trigger": "pointermove",
      "enterAlso": "lift.holdAtEnd",
      "asset": {
        "type": "frameSequence",
        "dir": "tracks",
        "pattern": "frame{NNN}.webp",
        "zeroPad": 3,
        "indexBase": 1,
        "from": 73,
        "to": 100
      }
    },
    "drop": {
      "label": "落下",
      "playback": "once",
      "holdAtEnd": true,
      "fallback": "idle",
      "trigger": "pointerup",
      "asset": {
        "type": "frameSequence",
        "dir": "tracks",
        "pattern": "frame{NNN}.webp",
        "zeroPad": 3,
        "indexBase": 1,
        "from": 101,
        "to": 193
      }
    }
  },
  "interrupt": {
    "pointerupDuringLift": "drop",
    "pointerupDuringHover": "drop",
    "pointerdownDuringDrop": "lift",
    "pointerdownWhileIdle": "lift",
    "holdStillAfterLift": "enterHover",
    "rapidClick": "liftThenDrop"
  },
  "assetTypes": {
    "animatedWebp": {
      "required": [
        "src"
      ],
      "optional": [
        "fps",
        "loopStart",
        "loopEnd"
      ],
      "desc": "单个有动画的 WebP 文件，整段作为该相位"
    },
    "frameSequence": {
      "required": [
        "dir",
        "from",
        "to"
      ],
      "optional": [
        "pattern",
        "zeroPad",
        "indexBase",
        "ext"
      ],
      "desc": "目录内连续帧；pattern 默认 frame{NNN}.webp"
    }
  },
  "frameCount": 193,
  "compat": {
    "idleWebpSize": "180x240",
    "note": "本序列画布高于 idle.webp；运行时按 frameSize 布局，idle 相位仍可用 180×240 资源居中叠放"
  }
}
